# Template for .env, which is never committed.
# Run scripts/init-secrets.sh: it copies this file to .env and fills every empty value
# with a random password, then writes the matching Kubernetes dev secrets.

# Host port of the API gateway.
GATEWAY_PORT=8080

# PostgreSQL superuser, used only to create the per-service roles.
POSTGRES_PASSWORD=

# One role per service, each owning only its own database.
USER_SERVICE_DB_PASSWORD=
PRODUCT_SERVICE_DB_PASSWORD=
ORDER_SERVICE_DB_PASSWORD=

RABBITMQ_USER=app
RABBITMQ_PASSWORD=

GRAFANA_ADMIN_PASSWORD=
